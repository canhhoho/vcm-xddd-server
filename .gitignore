# ==================================
# CHỈ UPLOAD FOLDER server/ LÊN GITHUB
# Các file khác chỉ dùng local
# ==================================

# --- BỎ QUA TẤT CẢ MẶC ĐỊNH ---
*

# --- CHỈ CHO PHÉP CÁC FILE DEPLOY ---
!.gitignore

# Frontend build output
!dist/
!dist/**

# Frontend source code
!frontend/
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/eslint.config.js
!frontend/.env.development
!frontend/.env.production

# Server source code (code chính)
!server/
!server/src/
!server/src/**

# Server dependencies
!server/package.json
!server/package-lock.json
!server/.env.example

# DB init scripts (cần cho lần đầu setup)
!server/scripts/
!server/scripts/init-db.sql
!server/scripts/seed-data.sql
!server/scripts/auto-migrate.js

# Migration scripts (quy trình update trên server cần các file này)
!server/scripts/run-migration.js
!server/scripts/migrate-add-project-logs.sql
!server/scripts/migrate-monthly-daily-plans.sql
!server/scripts/migrate-add-plans-permission.sql
!server/scripts/migrate-plan-constraints.sql
!server/scripts/migrate-add-last-seen.sql
!server/scripts/migrate-add-notifications-read.sql
!server/scripts/migrate-add-pretax-value.sql
!server/scripts/migrate-plan-assignee-text.sql
!server/scripts/migrate-add-contract-investor.sql
!server/scripts/migrate-target-allocation.js
!server/scripts/fix-position-uuid.sql

# Script verify (chạy assertion trên API + DB local)
!server/scripts/verify-plans.js
!server/scripts/verify-contracts.js

# Script chẩn đoán (chỉ đọc, chạy được trên production)
!server/scripts/report-duplicate-targets.js

# Upload folder structure
!server/uploads/
!server/uploads/.gitkeep

# --- LUÔN BỎ QUA ---
node_modules/
.env
.env.local
*.log
*.bak

# Ghi chú riêng theo máy, không chia sẻ với team
# (đã bị pattern "*" ở trên chặn sẵn — liệt kê ở đây cho rõ chủ ý)
CLAUDE.local.md
